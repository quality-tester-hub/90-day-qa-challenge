      "name": "Auth",
      "item": [
        {
          "name": "POST Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login successful - status 200 or 302\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});",
                  "",
                  "pm.test(\"Response contains welcome message or redirect\", function () {",
                  "    const responseText = pm.response.text();",
                  "    const hasWelcome = responseText.includes(\"Welcome\") || responseText.includes(\"Signed in\") || responseText.includes(\"agileway\");",
                  "    const isRedirect = pm.response.code === 302;",
                  "    pm.expect(hasWelcome || isRedirect).to.be.true;",
                  "});",
                  "",
                  "// Capture session cookie if present",
                  "const cookies = pm.response.headers.get(\"Set-Cookie\");",
                  "if (cookies) {",
                  "    pm.collectionVariables.set(\"sessionCookie\", cookies);",
                  "    console.log(\"Session cookie captured:\", cookies);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            }
          },
          "response": []
        }
      ]
