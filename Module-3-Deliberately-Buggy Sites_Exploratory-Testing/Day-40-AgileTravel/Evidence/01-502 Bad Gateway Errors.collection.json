    {
      "name": "Payment & Booking",
      "item": [
        {
          "name": "POST Passenger & Fare Details",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Passenger submission - status 200 or 302\", function () {\n    pm.expect(pm.response.code).to.be.oneOf([200, 302]);\n});\n\npm.test(\"Response does not expose raw card data\", function () {\n    const responseText = pm.response.text();\n    pm.expect(responseText).to.not.include(\"4111111111111111\");\n    pm.expect(responseText).to.not.include(\"123\");\n});\n\npm.test(\"Fare parameter tampering check - fare value sent\", function () {\n    // Verify the fare value was accepted/processed (not silently dropped)\n    console.log(\"Fare submitted: 2500.00 (testing parameter tampering)\");\n    pm.expect(pm.response.code).to.be.oneOf([200, 302, 400, 422]);\n});\n\npm.test(\"Response time is acceptable\", function () {\n    pm.expect(pm.response.responseTime).to.be.below(5000);\n});\n\n// Check if booking number is returned\nconst responseText = pm.response.text();\nif (responseText.includes(\"booking\") || responseText.includes(\"Booking\") || responseText.includes(\"confirmation\")) {\n    const bookingMatch = responseText.match(/[Bb]ooking\\s*[#:]?\\s*([A-Z0-9]+)/);\n    if (bookingMatch) {\n        pm.collectionVariables.set(\"bookingNumber\", bookingMatch[1]);\n        console.log(\"Booking number captured:\", bookingMatch[1]);\n    }\n}\n\npm.test(\"Security: Card CVV not reflected in response\", function () {\n    pm.expect(pm.response.text()).to.not.include(\"123\");\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "{{sessionCookie}}",
                "description": "Session cookie captured from POST /login"
