    {
      "name": "Flight Selection",
      "item": [
        {
          "name": "GET Select Flight Date",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Flight selection page loads - status 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response contains flight options or form\", function () {\n    const responseText = pm.response.text();\n    pm.expect(responseText).to.satisfy(function(text) {\n        return text.includes(\"flight\") || text.includes(\"Flight\") || text.includes(\"select\") || text.includes(\"depart\");\n    }, \"Response should contain flight-related content\");\n});\n\npm.test(\"Response time is acceptable\", function () {\n    pm.expect(pm.response.responseTime).to.be.below(5000);\n});\n\n// Parameter boundary tests - log values\nconsole.log(\"Testing route: Sydney -> London\");\nconsole.log(\"Depart: 15/11/2026, Return: 22/11/2026\");\n\npm.test(\"Boundary test - departDay is valid (1-31)\", function () {\n    const departDay = 15;\n    pm.expect(departDay).to.be.within(1, 31);\n});\n\npm.test(\"Boundary test - returnDay is after departDay\", function () {\n    const departDay = 15;\n    const returnDay = 22;\n    pm.expect(returnDay).to.be.greaterThan(departDay);\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "{{sessionCookie}}",
                "description": "Session cookie captured from POST /login"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/flights/select_date?tripType=return&fromPort=Sydney&toPort=London&departDay=15&departMonth=11&departYear=2026&returnDay=22&returnMonth=11&returnYear=2026",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "flights",
                "select_date"
              ],
              "query": [
                {
                  "key": "tripType",
                  "value": "return"
