    {
      "name": "Cleanup",
      "item": [
        {
          "name": "DELETE John Wick",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var statusCode = pm.response.code;",
                  "var jsonData = pm.response.json();",
                  "",
                  "if (statusCode === 200) {",
                  "    pm.test(\"John Wick deleted successfully\", function () {",
                  "        pm.expect(jsonData.message).to.eql(\"Registro excluído com sucesso\");",
                  "    });",
                  "} else if (statusCode === 400 && jsonData.idCarrinho) {",
                  "    pm.test(\"[BLOCKED] Cannot delete user with active cart\", function () {",
                  "        pm.expect(jsonData.message).to.eql(\"Não é permitido excluir usuário com carrinho cadastrado\");",
                  "        console.log(\"Cart ID blocking deletion: \" + jsonData.idCarrinho);",
                  "        pm.environment.set(\"johnWickCartId\", jsonData.idCarrinho);",
                  "    });",
                  "} else {",
                  "    pm.test(\"Unexpected response on DELETE\", function () {",
                  "        console.log(\"Status: \" + statusCode);",
                  "        console.log(\"Response: \" + pm.response.text());",
                  "        pm.expect(statusCode).to.be.oneOf([200, 400]);",
                  "    });",
                  "}"
                ]
              }
            }
