    {
      "name": "Server Error (Deliberate 500 Test)",
      "item": [
        {
          "name": "Trigger Server Error (Deliberate)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// DELIBERATELY TRIGGERED SERVER ERROR TEST",
                  "// Purpose: Detect and document unexpected server failures",
                  "// The 'administrador' param only accepts 'true' or 'false'",
                  "// Passing an invalid value may trigger a 500 Internal Server Error",
                  "",
                  "var statusCode = pm.response.code;",
                  "",
                  "pm.test(\"[DELIBERATE] Server responded to invalid input\", function () {",
                  "    // We accept either 400 (validation) or 500 (server crash) as valid outcomes",
                  "    pm.expect([400, 500]).to.include(statusCode);",
                  "});",
                  "",
                  "if (statusCode === 500) {",
                  "    pm.test(\"[DELIBERATE] 500 Internal Server Error was triggered and captured\", function () {",
                  "        pm.expect(statusCode).to.eql(500);",
                  "        console.log(\"DELIBERATE SERVER ERROR TRIGGERED\");",
                  "        console.log(\"Status: \" + statusCode);",
                  "        console.log(\"Response: \" + pm.response.text());",
                  "    });",
                  "} else {",
                  "    pm.test(\"[INFO] Server returned \" + statusCode + \" instead of 500 - server handled invalid input gracefully\", function () {",
                  "        pm.expect(statusCode).to.be.oneOf([400, 500]);",
                  "        console.log(\"Server did not crash. Status: \" + statusCode);",
                  "        console.log(\"Response: \" + pm.response.text());",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios?administrador=INVALID_VALUE_TO_TRIGGER_500",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ],
              "query": [
                {
                  "key": "administrador",
                  "value": "INVALID_VALUE_TO_TRIGGER_500"
                }
              ]
            },
            "description": "This request deliberately attempts to trigger a 500 Internal Server Error by passing an invalid value for the 'administrador' query parameter. The 'administrador' field only accepts 'true' or 'false'. Passing an invalid value may cause the server to crash. This test documents the server's behavior under unexpected input. If the server returns 400 instead of 500, that is also acceptable and should be noted."
          },
          "response": []
        }
      ]
