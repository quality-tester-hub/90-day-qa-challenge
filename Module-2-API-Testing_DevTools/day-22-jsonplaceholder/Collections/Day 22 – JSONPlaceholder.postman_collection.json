      "name": "Phase 1 – Posts",
      "item": [
        {
          "name": "01 – GET /posts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array of 100 posts\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    pm.expect(jsonData.length).to.eql(100);",
                  "});",
                  "",
                  "pm.test(\"Each post has userId, id, title, body\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    jsonData.forEach(function(post) {",
                  "        pm.expect(post).to.have.property('userId');",
                  "        pm.expect(post).to.have.property('id');",
                  "        pm.expect(post).to.have.property('title');",
                  "        pm.expect(post).to.have.property('body');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            }
