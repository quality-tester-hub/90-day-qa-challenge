    {
      "name": "Characters",
      "item": [
        {
          "name": "GET SINGLE CHARACTER",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Response is successful\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains data\", function () {",
                  "    pm.expect(jsonData).to.have.property(\"data\");",
                  "});",
                  "",
                  "pm.test(\"data.character exists\", function () {",
                  "    pm.expect(jsonData.data).to.have.property(\"character\");",
                  "});",
                  "",
                  "pm.test(\"Returned ID matches characterId\", function () {",
                  "    pm.expect(String(jsonData.data.character.id)).to.eql(pm.environment.get(\"characterId\"));",
                  "});",
                  "",
                  "pm.test(\"Requested fields exist\", function () {",
                  "    const c = jsonData.data.character;",
                  "    pm.expect(c).to.have.property(\"name\");",
                  "    pm.expect(c).to.have.property(\"status\");",
                  "    pm.expect(c).to.have.property(\"species\");",
                  "    pm.expect(c).to.have.property(\"type\");",
                  "    pm.expect(c).to.have.property(\"gender\");",
                  "});",
                  "",
                  "pm.test(\"Nested origin.name is returned\", function () {",
                  "    pm.expect(jsonData.data.character.origin).to.have.property(\"name\");",
                  "});",
                  "",
                  "pm.test(\"Nested location.name is returned\", function () {",
                  "    pm.expect(jsonData.data.character.location).to.have.property(\"name\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query {\n  character(id: {{characterId}}) {\n    id\n    name\n    status\n    species\n    type\n    gender\n    origin {\n      name\n    }\n    location {\n      name\n    }\n  }\n}",
                "variables": ""
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ]
            }
          },
          "response": []
