  "item": [
    {
      "name": "Get Products",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "pm.test(\"Response has products array\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property(\"products\");",
              "    pm.expect(json.products).to.be.an(\"array\");",
              "});",
              "pm.test(\"Products array has at least one record\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.products.length).to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        }
      },
      "response": []
    },
